diff --git a/node_modules/app-builder-lib/templates/nsis/multiUser.nsh b/node_modules/app-builder-lib/templates/nsis/multiUser.nsh
index 3de631b..a001e0b 100644
--- a/node_modules/app-builder-lib/templates/nsis/multiUser.nsh
+++ b/node_modules/app-builder-lib/templates/nsis/multiUser.nsh
@@ -28,15 +28,28 @@ Var installMode
       StrCpy $INSTDIR $perUserInstallationFolder
     ${else}
       StrCpy $0 "$LocalAppData\Programs"
-      System::Store S
-      # Win7 has a per-user programfiles known folder and this can be a non-default location
+
+      # Copies only up to the folder path's terminating null. The original
+      # read NSIS_MAX_STRLEN wide chars (16 KB) out of the few dozen bytes
+      # SHGetKnownFolderPath allocates, and when that ran off the end of
+      # the heap the installer crashed (0xC0000005 in System.dll) before
+      # installing anything, on roughly 1 in 3 first-time installs. This
+      # is the fix electron-builder itself shipped in 26.x.
+      Push $1
+      Push $2
+      # UserProgramFiles is the per-user install root and can be a non-default location
+      StrCpy $2 0
       System::Call 'SHELL32::SHGetKnownFolderPath(g "${FOLDERID_UserProgramFiles}", i ${KF_FLAG_CREATE}, p 0, *p .r2)i.r1'
       ${If} $1 == 0
-        System::Call '*$2(&w${NSIS_MAX_STRLEN} .s)'
-        StrCpy $0 $1
+        System::Call 'KERNEL32::lstrcpynW(w .r0, p r2, i ${NSIS_MAX_STRLEN})p'
+      ${endif}
+      # SHGetKnownFolderPath may return allocated memory even on failure
+      ${If} $2 != 0
         System::Call 'OLE32::CoTaskMemFree(p r2)'
       ${endif}
-      System::Store L
+      Pop $2
+      Pop $1
+
       StrCpy $INSTDIR "$0\${APP_FILENAME}"
     ${endif}
 
